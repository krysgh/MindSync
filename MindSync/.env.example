# Copie este arquivo para ".env" (na mesma pasta do docker-compose.yml) e preencha com valores reais.
# O arquivo ".env" está na lista de ignorados do git e nunca deve ser enviado ao repositório (commit).

# Deve atender à política de senhas do SQL Server: pelo menos 8 caracteres, incluindo pelo menos
# três dos seguintes itens: letras maiúsculas, letras minúsculas, dígitos e símbolos.
MSSQL_SA_PASSWORD=Sua_Senha_F0rte!

# Qualquer sequência longa aleatória serve. Gerador de exemplo: openssl rand -base64 48
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatório-de-pelo-menos-32-caracteres