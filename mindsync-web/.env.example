# Copie este arquivo para ".env" (na mesma pasta do package.json) e ajuste, se necessário.
# Não contém informações sensíveis por si só (é apenas a URL base do backend),
# mas é mantido fora do git para que cada ambiente possa apontar para
# uma API diferente sem alterar arquivos rastreados pelo controle de versão.

VITE_API_URL=http://localhost:5000/api